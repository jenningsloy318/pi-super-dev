{
	"name": "pi-super-dev",
	"version": "0.3.64",
	"description": "Self-contained, modular development pipeline for the Pi coding agent, built on a composable control-flow node algebra (branch/parallel/loop/retry/gate/map/wait). Spawns specialist pi subagents directly — no external workflow engine required.",
	"private": false,
	"type": "module",
	"license": "MIT",
	"author": "Jennings Liu",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jenningsloy318/pi-super-dev.git"
	},
	"homepage": "https://github.com/jenningsloy318/pi-super-dev#readme",
	"bugs": {
		"url": "https://github.com/jenningsloy318/pi-super-dev/issues"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"workflow",
		"pi",
		"pipeline",
		"tdd",
		"control-flow"
	],
	"exports": {
		"./extension": "./src/extension.ts",
		"./pipeline": "./src/pipeline.ts",
		"./nodes": "./src/nodes.ts",
		"./workflow": "./src/workflow.ts",
		"./stages": "./src/stages/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"arch:doc": "node src/render/arch-doc.ts",
		"test:unit": "vitest run \"tests/*.unit.test.ts\" \"src/**/*.unit.test.ts\" --passWithNoTests",
		"test:contract": "vitest run \"tests/*.contract.test.ts\" \"src/**/*.contract.test.ts\" --passWithNoTests",
		"test:integration": "vitest run \"tests/*.integration.test.ts\" \"src/**/*.integration.test.ts\" --passWithNoTests",
		"test:pipeline": "vitest run \"tests/*.pipeline.test.ts\" \"src/**/*.pipeline.test.ts\" --passWithNoTests"
	},
	"files": [
		"src",
		"agents",
		"skills",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"pi": {
		"extensions": [
			"./src/extension.ts"
		],
		"skills": [
			"./skills/super-dev"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.82.1",
		"@earendil-works/pi-coding-agent": "^0.82.1",
		"@earendil-works/pi-tui": "^0.82.1",
		"@types/node": "^22.0.0",
		"@vitest/coverage-v8": "^3.2.6",
		"typebox": "1.1.38",
		"typescript": "^5.4",
		"vitest": "^3.0"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
